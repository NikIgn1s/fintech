{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finflow.dev/contracts/transactions-imported.schema.json",
  "title": "TransactionsImported",
  "description": "Published by finflow-core to transactions.imported when a bank statement import finished with new rows",
  "type": "object",
  "required": ["eventId", "eventType", "version", "occurredAt", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "TransactionsImported" },
    "version": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["importId", "userId", "importedRows", "skippedRows", "failedRows", "earliestDate", "latestDate"],
      "properties": {
        "importId": { "type": "string", "format": "uuid" },
        "userId": { "type": "string", "format": "uuid" },
        "importedRows": { "type": "integer", "minimum": 1 },
        "skippedRows": { "type": "integer", "minimum": 0 },
        "failedRows": { "type": "integer", "minimum": 0 },
        "earliestDate": { "type": "string", "format": "date" },
        "latestDate": { "type": "string", "format": "date" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
